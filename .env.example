# Supabase Postgres connection string (Settings -> Database -> Connection string -> URI)
# Use the "Transaction pooler" (port 6543) connection string — Render's outbound
# connections work more reliably through the pooler than the direct :5432 host.
DATABASE_URL=postgresql://postgres.xxxxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Any random string, used to sign Flask session cookies
FLASK_SECRET_KEY=changeme

# Render sets PORT automatically; only needed for local runs
PORT=5000
